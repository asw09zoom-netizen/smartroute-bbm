{
  "name": "SMARTROUTE-BBM",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "hostRequirements": { "cpus": 4 },
  "postCreateCommand": "pip install --no-cache-dir -r requirements.txt",
  "postAttachCommand": "streamlit run app.py --server.port 8501 --server.headless true --server.enableCORS false --server.enableXsrfProtection false",
  "forwardPorts": [8501],
  "portsAttributes": { "8501": { "label": "SMARTROUTE-BBM", "onAutoForward": "openBrowser" } },
  "customizations": { "codespaces": { "openFiles": ["README.md"] } }
}
