# Salin menjadi .streamlit/secrets.toml (lokal) atau tempel di Streamlit Cloud > App settings > Secrets.
# JANGAN commit secrets.toml ke GitHub.

[sheets]
# ID spreadsheet "SMARTROUTE-BBM Database" (bagian URL di antara /d/ dan /edit)
spreadsheet_id = "1CohYmRvhwtAD3y34z9DmqEYkp-sfHlJ1g_Zs4YWPRq4"

# Opsional: untuk menulis log simulasi ke tab tb_simulasi_log.
# Buat service account di Google Cloud Console, aktifkan Google Sheets API,
# lalu bagikan spreadsheet ke email service account sebagai Editor.
# [gcp_service_account]
# type = "service_account"
# project_id = "..."
# private_key_id = "..."
# private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# client_email = "smartroute@PROJECT.iam.gserviceaccount.com"
# client_id = "..."
# token_uri = "https://oauth2.googleapis.com/token"

# Opsional: notifikasi Telegram
# [telegram]
# bot_token = "123456:ABC..."
# chat_id = "-100123456789"
